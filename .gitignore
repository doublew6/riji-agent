# Secrets and local configuration
.env
.env.*
!.env.example

# Python tooling
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Local state. Keep all runtime data outside the repository by default.
# Anchored to the repo root so they don't shadow source packages of the same name.
/data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
*.db
*.db-shm
*.db-wal
*.db-journal
*.log
/audit/
/logs/
/output/
/private/
/runtime/
/backups/
/exports/
/export/
/deploy-backups/
/MEMORY.md

# Synthetic test data remains publishable when deliberately stored with tests.
!tests/fixtures/**/*.sqlite
!tests/fixtures/**/*.sqlite3
!tests/fixtures/**/*.db
!tests/fixtures/**/*.log
!evals/fixtures/**/*.sqlite
!evals/fixtures/**/*.sqlite3
!evals/fixtures/**/*.db
!evals/fixtures/**/*.log

# Journal material must never be copied into this repository.
/riji/
/journals/

# Local agent worktrees / harness state
.claude/
CLAUDE.md

# Generated BMAD runtime and host-specific workflow snapshots
/_bmad/scripts/
/_bmad/render/
**/.memlog.md

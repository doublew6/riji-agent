<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>Label</key><string>ai.riji-agent.mobile-public-proxy</string>
    <key>ProgramArguments</key><array>
        <string>__RUNTIME_EXECUTABLE__</string><string>mobile</string><string>public-proxy</string>
    </array>
    <key>WorkingDirectory</key><string>__RUNTIME_DIRECTORY__</string>
    <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>30</integer>
    <key>StandardOutPath</key><string>__LOCAL_LOG_DIR__/mobile-public-proxy.log</string>
    <key>StandardErrorPath</key><string>__LOCAL_LOG_DIR__/mobile-public-proxy-error.log</string>
</dict></plist>

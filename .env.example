# Required: absolute path to the existing Obsidian riji directory. It is never copied.
RIJI_JOURNAL_ROOT=/absolute/path/to/your/Obsidian/riji

# Optional: local runtime state, outside this Git repository.
# Default: ~/.local/share/riji-agent (or the platform equivalent)
# RIJI_DATA_DIR=/absolute/path/to/riji-agent-data
# RIJI_DATABASE_PATH=/absolute/path/to/riji-agent-data/riji-agent.sqlite3

# Default cloud model credential. Required while chat or active memory uses
# DeepSeek. Keep this file local; Codex-only application use does not need it.
RIJI_IM_PROVIDER=feishu
RIJI_AGENT_RUNTIME=hermes
RIJI_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Optional: deepseek-reasoner (default) or deepseek-chat.
# DEEPSEEK_MODEL=deepseek-reasoner

# Optional: select a different model adapter. Supported: deepseek (default),
# openai (any OpenAI-compatible endpoint), codex (ChatGPT subscription login).
# When RIJI_MODEL_PROVIDER=openai, set the three RIJI_MODEL_* values below.
# Memory extraction selects its model separately and may still use DeepSeek.
# RIJI_MODEL_PROVIDER=openai
# RIJI_MODEL_API_KEY=replace-me
# RIJI_MODEL_BASE_URL=https://api.openai.com/v1
# RIJI_MODEL_NAME=gpt-4o-mini

# Optional: official Codex adapter. Use a dedicated persistent RIJI_CODEX_HOME
# (default RIJI_DATA_DIR/codex). Log in once as the service OS user by running
# CODEX_HOME=<that-directory> codex login; the official client owns credential
# refresh. Do not copy/link auth files from another Codex home. API-key login is
# rejected to prevent unexpected API billing. Existing ChatGPT allowance is
# shared with other Codex use. Quota/auth failures never fall back to DeepSeek.
# This still sends permitted content to OpenAI, not local model inference.
# RIJI_MODEL_PROVIDER=codex
# RIJI_MEMORY_MODEL_PROVIDER=codex
# RIJI_CODEX_BIN=codex
# RIJI_CODEX_HOME=/absolute/path/to/riji-agent-data/codex
# Optional existing local HTTP(S) proxy, used only by Codex child processes.
# Require a loopback host and explicit port; credentials and URL suffixes are
# rejected. No system proxy discovery or changes; Feishu/Mem0 are unaffected.
# When unset, Codex keeps the proxy environment inherited from its parent.
# RIJI_CODEX_PROXY_URL=http://127.0.0.1:15236
# RIJI_CODEX_MODEL=gpt-5.6-terra
# RIJI_MEMORY_CODEX_MODEL=gpt-5.6-luna
# RIJI_CODEX_TIMEOUT_SECONDS=90

# Optional: private execution traces in a local Opik project. This file stores
# only the policy location. The mode-0600 policy and JSONL output must both be
# absolute paths outside every Git worktree; install compatible EvalMesh + Opik
# into the service environment before enabling it.
# Set the real absolute path only in the untracked local .env or service manager.
# RIJI_RUNTIME_TRACE_POLICY_PATH=

# Optional Agent long-term memory. The default remains the legacy local SQLite
# store until migration is complete. Mem0 stays on loopback and its API key is
# never sent to the browser.
# RIJI_MEMORY_PROVIDER=mem0
# Select extraction, relationship and organization model independently from chat:
# RIJI_MEMORY_MODEL_PROVIDER=deepseek
# RIJI_MEM0_BASE_URL=http://127.0.0.1:38881
# RIJI_MEM0_DASHBOARD_URL=http://127.0.0.1:38880
# RIJI_MEM0_API_KEY=replace-with-local-mem0-api-key
# RIJI_MEMORY_AUTO_CAPTURE=true
# RIJI_MEMORY_CONTEXT_MAX_CHARS=2000
# RIJI_MEMORY_SNAPSHOT_ENABLED=true
# RIJI_MEMORY_SNAPSHOT_PATH=/absolute/path/to/riji-agent-data/memory/MEMORY.md

# Optional journal-derived memory: disabled until the local owner explicitly
# selects sections. Requires Mem0 and the journal API extension shipped here.
# The owner must be in RIJI_ALLOWED_FEISHU_USER_IDS. Never set this to a guess.
# RIJI_JOURNAL_MEMORY_ENABLED=false
# RIJI_JOURNAL_MEMORY_USER_ID=ou_replace_with_allowed_owner
# RIJI_JOURNAL_MEMORY_SECTIONS=🧠 Notes
# Optional inclusive source-date range in YYYY-MM-DD; omit to include unknown dates.
# RIJI_JOURNAL_MEMORY_DATE_FROM=2026-01-01
# RIJI_JOURNAL_MEMORY_DATE_TO=2026-12-31
# Input character budgets, not billing tokens. The daily budget uses UTC.
# RIJI_JOURNAL_MEMORY_SEGMENT_CHARS=900
# RIJI_JOURNAL_MEMORY_SOURCE_CHARS=4000
# Ordinary processing uses a daily UTC request-character allowance.
# RIJI_JOURNAL_MEMORY_DAILY_CHARS=100000
# Optional one-time initialization batch, frozen to the first authorized scan's
# evidence IDs and versions. Its extraction/relations and necessary fixed-version
# organization are counted separately without a daily total limit. Later diary
# additions/edits remain on the ordinary daily budget. Fragment/source limits
# still apply; completion or terminal failures end this batch's exemption.
# RIJI_JOURNAL_MEMORY_INITIALIZATION_UNLIMITED=false
# RIJI_JOURNAL_MEMORY_SCAN_SECONDS=60

# Optional local Memory Review UI at http://127.0.0.1:8765/admin/memory.
# Use a separate random token of at least 16 characters.
# RIJI_MEMORY_REVIEW_ENABLED=true
# RIJI_MEMORY_REVIEW_TOKEN=replace-with-a-separate-random-token

# Required: only these Feishu open IDs may use private-chat journal tools.
# Separate multiple IDs with commas. Group chats are denied by design.
RIJI_ALLOWED_FEISHU_USER_IDS=ou_replace_me

# Required: shared credential for the local Hermes-to-riji-agent tool boundary.
HERMES_SHARED_SECRET=replace-with-a-long-random-secret
HERMES_BASE_URL=http://127.0.0.1:3000

# Hermes-side Feishu bridge (src/riji_agent/integrations/hermes_bridge.py).
# Where the bridge POSTs each Feishu private message; the secret above must
# match riji-agent's HERMES_SHARED_SECRET. Default below; uncomment to override.
# RIJI_AGENT_URL=http://127.0.0.1:8765/hermes/messages
# RIJI_AGENT_TIMEOUT_SECONDS=240

# Optional: Feishu calendar creation from IM. Default is off. When enabled,
# natural-language calendar requests create a local preview first; only
# "确认创建" calls Feishu and then links the event to the daily note.
# RIJI_CALENDAR_PROVIDER=feishu
# FEISHU_APP_ID=cli_replace_me
# FEISHU_APP_SECRET=replace-me
# FEISHU_CALENDAR_ID=primary
# FEISHU_OPEN_BASE_URL=https://open.feishu.cn

# The application listener is intentionally fixed to 127.0.0.1.
RIJI_PORT=8765

# Optional: background journal indexing.
# RIJI_INDEX_SCHEDULE_ENABLED=true        # periodic incremental indexing while running
# RIJI_INDEX_INTERVAL_SECONDS=600         # how often to re-index (default 10 min)
# RIJI_INDEX_STARTUP_TIMEOUT_SECONDS=10   # max seconds to wait for the first index at startup
# RIJI_INDEX_FILE_TIMEOUT_SECONDS=5       # per-file read budget; a slow/cold (iCloud) file is skipped past this

# Optional: enable local hybrid keyword+semantic search (embeddings stay on-device).
# RIJI_SEMANTIC_SEARCH=false

# Optional: Feishu voice replies. Default is text-only.
# When set to text_and_voice, riji-agent keeps the normal text reply and also
# asks a local TTS provider to create an audio attachment for Hermes/Feishu.
# The macos_say provider stays on this Mac; generated files live outside the vault.
# RIJI_FEISHU_VOICE_REPLY_MODE=off
# RIJI_TTS_PROVIDER=macos_say
# RIJI_TTS_VOICE=Tingting
# RIJI_TTS_MAX_CHARS=1200
# RIJI_TTS_OUTPUT_DIR=/absolute/path/to/riji-agent-data/voice

# Optional: natural local TTS via MeloTTS. Install it into the same virtualenv
# before selecting this provider, for example:
#   uv pip install melotts
# The first run may download or prepare model assets outside this repository,
# depending on MeloTTS/Hugging Face cache state.
# RIJI_FEISHU_VOICE_REPLY_MODE=text_and_voice
# RIJI_TTS_PROVIDER=melotts
# RIJI_TTS_LANGUAGE=ZH
# RIJI_TTS_VOICE=ZH
# RIJI_TTS_DEVICE=auto
# RIJI_TTS_SPEED=1.0

# Optional: higher-quality local TTS via VoxCPM2. This is heavier than MeloTTS
# but supports natural-language voice design per mentor without reference audio.
# Install it separately into the same runtime before selecting this provider:
#   uv pip install voxcpm soundfile
# The first run downloads model assets outside this repository.
# RIJI_FEISHU_VOICE_REPLY_MODE=text_and_voice
# RIJI_TTS_PROVIDER=voxcpm
# RIJI_TTS_MODEL=openbmb/VoxCPM2
# RIJI_TTS_CFG_VALUE=2.0
# RIJI_TTS_INFERENCE_TIMESTEPS=10

# Fixed mentor conversations (opt-in). Keep this JSON private and outside the vault.
# It contains identity mappings and environment-variable references, never secrets.
RIJI_MENTORS_ENABLED=false
# RIJI_MENTORS_CONFIG_PATH=/absolute/private/path/mentors.json
